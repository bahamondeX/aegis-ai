# Optional credentials. Keep the local .env mode at 600.
NVD_API_KEY=
SHODAN_API_KEY=

# AWS deployment target. Fill in the explicitly authorized account, region and profile.
AEGIS_AWS_ACCOUNT=
AEGIS_AWS_REGION=
AEGIS_AWS_PROFILE=
AEGIS_PROJECT_PREFIX=aegis-dev
AEGIS_SCHEDULE_ENABLED=0

# Fill in after authorization. Approval format is account-id/region/project-prefix.
AEGIS_DEPLOY_APPROVAL=
AEGIS_BUDGET_USD=

# Optional scoped CDK bootstrap policy and separately authorized teardown.
AEGIS_CDK_EXECUTION_POLICY_ARN=
AEGIS_DESTROY_APPROVAL=

AEGIS_DATA_DIR=data
AEGIS_SNAPSHOT=

# Optional Bedrock inference. Fill in only after separate scoped authorization.
# Approval format is account-id/region/project-prefix/bedrock.
BEDROCK_MODEL_ID=
AEGIS_BEDROCK_APPROVAL=
AEGIS_BEDROCK_TOTAL_BUDGET_USD=
AEGIS_BEDROCK_BUDGET_USD=
AEGIS_BEDROCK_RUNTIME_BUDGET_USD=
AEGIS_BEDROCK_INPUT_USD_PER_MILLION=
AEGIS_BEDROCK_OUTPUT_USD_PER_MILLION=

# Approval format is account-id/region/project-prefix/agentcore.
AEGIS_AGENTCORE_APPROVAL=
AEGIS_AGENTCORE_BUDGET_USD=

# Separate approval for a future hosted pilot. Leave blank until explicitly authorized.
# Format for approval is account/region/project-prefix/hosting.
AEGIS_HOSTING_APPROVAL=
AEGIS_HOSTING_BUDGET_USD=

# V2 approvals use the account/region/project scope and a reviewed SHA-256 digest.
AEGIS_V2_MIGRATION_APPROVAL=
AEGIS_V2_MIGRATION_USD=
AEGIS_V2_MIGRATION_BYTES=
AEGIS_V2_MIGRATION_OBJECTS=
AEGIS_V2_EPSS_PLAN_APPROVAL=
AEGIS_V2_EPSS_PLAN_USD=
AEGIS_V2_ONE_TIME_BUDGET_USD=
AEGIS_V2_HISTORY_APPROVAL=
AEGIS_V2_HISTORY_USD=
