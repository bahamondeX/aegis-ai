    "Filters": {
      "additionalProperties": false,
      "properties": {
        "country_iso2": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Iso2"
        },
        "cve_ids": {
          "default": [],
          "items": {
            "maxLength": 32,
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Cve Ids",
          "type": "array"
        },
        "date_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date From"
        },
        "date_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date To"
        },
        "kev_only": {
          "default": false,
          "title": "Kev Only",
          "type": "boolean"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "min_epss": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Epss"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "NONE",
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        }
      },
      "title": "Filters",
      "type": "object"
    },
