{
  "name": "aegis-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "contracts": "json2ts -i investigations/events.schema.json -o investigations/events.d.ts --unknownAny=true --additionalProperties=false --ignoreMinAndMaxItems=true",
    "typecheck": "nuxt typecheck",
    "test": "tsc -p tsconfig.contract.json --outDir .test-dist && node --test tests/*.test.mjs",
    "dev": "nuxt dev --host localhost",
    "build": "nuxt build",
    "lint": "nuxt prepare && eslint .",
    "browser": "playwright test"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/vue": "1.78.0",
    "@nuxt/ui": "4.13.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "cytoscape": "3.35.0",
    "echarts": "6.1.0",
    "globe.gl": "2.46.2",
    "i18n-iso-countries": "7.14.0",
    "maplibre-gl": "6.19.0",
    "nuxt": "4.7.0",
    "oidc-client-ts": "3.5.0",
    "tailwindcss": "4.3.0",
    "topojson-client": "3.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10.15.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "readdir-glob>minimatch": "11.0.1"
    }
  }
}
